rules_version = '2';

// J8 : le destinataire accepte dans une transaction
// (demande, relation, chat et séance) ou refuse la demande seule.
// J9 : un message appartient aux deux partenaires, avec un texte de 1 à 1 000 caractères.
// Les nombres ci-dessous suivent src/utils/profileValidation.ts.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileKeys() {
      return [
        "displayName",
        "city",
        "level",
        "goal",
        "sports",
        "availability",
        "bio",
        "gymId",
        "createdAt",
        "updatedAt"
      ];
    }

    function allowedSports() {
      return [
        "Musculation",
        "Fitness",
        "Running",
        "Cardio",
        "CrossFit",
        "Boxe"
      ];
    }

    function validAvailabilityItem(item) {
      return item.keys().hasOnly(["day", "start", "end"])
        && item.day is int
        && item.day >= 1
        && item.day <= 7
        && item.start is int
        && item.end is int
        && item.start >= 0
        && item.end <= 1440
        && item.start < item.end;
    }

    function validAvailability(items) {
      return items is list
        && items.size() <= 14
        && (items.size() < 1 || validAvailabilityItem(items[0]))
        && (items.size() < 2 || validAvailabilityItem(items[1]))
        && (items.size() < 3 || validAvailabilityItem(items[2]))
        && (items.size() < 4 || validAvailabilityItem(items[3]))
        && (items.size() < 5 || validAvailabilityItem(items[4]))
        && (items.size() < 6 || validAvailabilityItem(items[5]))
        && (items.size() < 7 || validAvailabilityItem(items[6]))
        && (items.size() < 8 || validAvailabilityItem(items[7]))
        && (items.size() < 9 || validAvailabilityItem(items[8]))
        && (items.size() < 10 || validAvailabilityItem(items[9]))
        && (items.size() < 11 || validAvailabilityItem(items[10]))
        && (items.size() < 12 || validAvailabilityItem(items[11]))
        && (items.size() < 13 || validAvailabilityItem(items[12]))
        && (items.size() < 14 || validAvailabilityItem(items[13]));
    }

    function validProfileShape(data) {
      return data.keys().hasOnly(profileKeys())
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.city is string
        && data.city.size() <= 60
        && (data.city.size() == 0 || data.city.size() >= 2)
        && data.level is string
        && data.level in ["", "beginner", "intermediate", "advanced"]
        && data.goal is string
        && data.goal.size() <= 80
        && data.sports is list
        && data.sports.size() <= 6
        && data.sports.hasOnly(allowedSports())
        && validAvailability(data.availability)
        && data.bio is string
        && data.bio.size() <= 280
        && (data.gymId == null || (data.gymId is string && data.gymId.size() > 0 && data.gymId.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function profileIsComplete(data) {
      return data.displayName.size() >= 2
        && data.city.size() >= 2
        && data.level in ["beginner", "intermediate", "advanced"]
        && data.goal.size() > 0
        && data.sports.size() > 0
        && data.availability.size() > 0;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function sameGymMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && resource.data.gymId is string
        && resource.data.gymId.size() > 0
        && currentUserData().gymId == resource.data.gymId;
    }

    function gymExists(gymId) {
      return exists(/databases/$(database)/documents/gyms/$(gymId));
    }

    match /gyms/{gymId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || sameGymMember();

      allow create: if isOwner(uid)
        && validProfileShape(request.resource.data)
        && request.resource.data.gymId == null
        && request.resource.data.city == ""
        && request.resource.data.level == ""
        && request.resource.data.goal == ""
        && request.resource.data.sports.size() == 0
        && request.resource.data.availability.size() == 0
        && request.resource.data.bio == ""
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && validProfileShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.gymId == resource.data.gymId
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  "displayName",
                  "city",
                  "level",
                  "goal",
                  "sports",
                  "availability",
                  "bio",
                  "updatedAt"
                ])
          )
          || (
            resource.data.gymId == null
            && request.resource.data.gymId is string
            && request.resource.data.gymId.matches('^[A-Za-z0-9_]+$')
            && gymExists(request.resource.data.gymId)
            && profileIsComplete(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["gymId", "updatedAt"])
          )
        );

      allow delete: if false;
    }

    function requestKeys() {
      return [
        "senderId",
        "receiverId",
        "members",
        "gymId",
        "sport",
        "startsAt",
        "endsAt",
        "timeZone",
        "message",
        "status",
        "createdAt",
        "respondedAt"
      ];
    }

    function profileGym(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.gymId;
    }

    function canonicalPairId(uidA, uidB) {
      return uidA < uidB
        ? uidA + '__' + uidB
        : uidB + '__' + uidA;
    }

    function pairContainsUid(pairId, uid) {
      return pairId.matches('^[A-Za-z0-9]+__[A-Za-z0-9]+$')
        && (
          pairId.matches('^' + uid + '__[A-Za-z0-9]+$')
          || pairId.matches('^[A-Za-z0-9]+__' + uid + '$')
        );
    }

    function sameParticipants(members, senderId, receiverId) {
      return members is list
        && members.size() == 2
        && members.hasAll([senderId, receiverId])
        && members.hasOnly([senderId, receiverId]);
    }

    function requestData(requestId) {
      return get(/databases/$(database)/documents/trainingRequests/$(requestId)).data;
    }

    function requestAfter(requestId) {
      return getAfter(/databases/$(database)/documents/trainingRequests/$(requestId)).data;
    }

    function relationKeys() {
      return ["members", "gymId", "sourceRequestId", "createdAt"];
    }

    function chatKeys() {
      return ["relationId", "members", "createdAt"];
    }

    function chatMember(pairId) {
      return exists(/databases/$(database)/documents/chats/$(pairId))
        && exists(/databases/$(database)/documents/relations/$(pairId))
        && get(/databases/$(database)/documents/chats/$(pairId)).data.relationId == pairId
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(pairId)).data.members
        && request.auth.uid in get(/databases/$(database)/documents/relations/$(pairId)).data.members;
    }

    function sessionKeys() {
      return [
        "requestId",
        "relationId",
        "members",
        "gymId",
        "sport",
        "startsAt",
        "endsAt",
        "timeZone",
        "status",
        "createdAt",
        "updatedAt"
      ];
    }

    function relationShapeIsValid(pairId, data) {
      return data.members is list
        && data.members.size() == 2
        && data.members[0] is string
        && data.members[1] is string
        && data.members[0] < data.members[1]
        && pairId == data.members[0] + '__' + data.members[1]
        && request.auth.uid in data.members
        && data.gymId is string
        && data.gymId.matches('^[A-Za-z0-9_]+$')
        && data.sourceRequestId is string
        && data.sourceRequestId.size() > 0
        && data.createdAt == request.time;
    }

    function relationMatchesSource(data, source) {
      return source.status == "accepted"
        && source.receiverId == request.auth.uid
        && source.respondedAt == request.time
        && source.gymId == data.gymId
        && sameParticipants(data.members, source.senderId, source.receiverId);
    }

    function chatMatchesRelation(pairId, data, relation, source) {
      return data.relationId == pairId
        && data.createdAt == request.time
        && data.members == relation.members
        && request.auth.uid in data.members
        && source.status == "accepted"
        && source.receiverId == request.auth.uid
        && source.respondedAt == request.time;
    }

    function sessionMatchesRequest(data, source) {
      return source.status == "accepted"
        && source.receiverId == request.auth.uid
        && source.respondedAt == request.time
        && data.relationId == canonicalPairId(source.senderId, source.receiverId)
        && sameParticipants(data.members, source.senderId, source.receiverId)
        && data.gymId == source.gymId
        && data.sport == source.sport
        && data.sport in allowedSports()
        && data.startsAt == source.startsAt
        && data.endsAt == source.endsAt
        && data.timeZone == source.timeZone
        && data.timeZone == "Europe/Paris"
        && data.status == "planned"
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /trainingRequests/{requestId} {
      allow get: if signedIn() && (
        resource == null
        || resource.data.senderId == request.auth.uid
        || resource.data.receiverId == request.auth.uid
      );

      allow list: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(requestKeys())
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId.size() > 0
        && request.resource.data.receiverId != request.auth.uid
        && sameParticipants(
          request.resource.data.members,
          request.resource.data.senderId,
          request.resource.data.receiverId
        )
        && request.resource.data.gymId is string
        && request.resource.data.gymId.matches('^[A-Za-z0-9_]+$')
        && gymExists(request.resource.data.gymId)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.receiverId))
        && profileGym(request.auth.uid) == request.resource.data.gymId
        && profileGym(request.resource.data.receiverId) == request.resource.data.gymId
        && request.resource.data.sport in allowedSports()
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.endsAt > request.resource.data.startsAt
        && request.resource.data.timeZone == "Europe/Paris"
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.respondedAt == null;

      allow update: if signedIn()
        && request.auth.uid == resource.data.receiverId
        && resource.data.status == "pending"
        && request.resource.data.respondedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "respondedAt"])
        && (
          (
            request.resource.data.status == "rejected"
            && !existsAfter(/databases/$(database)/documents/trainingSessions/$(requestId))
          )
          || (
            request.resource.data.status == "accepted"
            && resource.data.startsAt > request.time
            && existsAfter(/databases/$(database)/documents/trainingSessions/$(requestId))
            && existsAfter(/databases/$(database)/documents/relations/$(canonicalPairId(resource.data.senderId, resource.data.receiverId)))
            && existsAfter(/databases/$(database)/documents/chats/$(canonicalPairId(resource.data.senderId, resource.data.receiverId)))
            && getAfter(/databases/$(database)/documents/trainingSessions/$(requestId)).data.requestId == requestId
            && getAfter(/databases/$(database)/documents/trainingSessions/$(requestId)).data.status == "planned"
            && getAfter(/databases/$(database)/documents/relations/$(canonicalPairId(resource.data.senderId, resource.data.receiverId))).data.members.hasAll([resource.data.senderId, resource.data.receiverId])
            && getAfter(/databases/$(database)/documents/chats/$(canonicalPairId(resource.data.senderId, resource.data.receiverId))).data.relationId == canonicalPairId(resource.data.senderId, resource.data.receiverId)
          )
        );

      allow delete: if false;
    }

    match /relations/{pairId} {
      allow get: if signedIn() && (
        resource == null
          ? pairContainsUid(pairId, request.auth.uid)
          : request.auth.uid in resource.data.members
      );

      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(relationKeys())
        && relationShapeIsValid(pairId, request.resource.data)
        && relationMatchesSource(
          request.resource.data,
          requestAfter(request.resource.data.sourceRequestId)
        )
        && gymExists(request.resource.data.gymId)
        && profileGym(request.resource.data.members[0]) == request.resource.data.gymId
        && profileGym(request.resource.data.members[1]) == request.resource.data.gymId;

      allow update, delete: if false;
    }

    match /chats/{pairId} {
      allow get: if signedIn() && (
        resource == null
          ? pairContainsUid(pairId, request.auth.uid)
          : request.auth.uid in resource.data.members
      );

      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(chatKeys())
        && existsAfter(/databases/$(database)/documents/relations/$(pairId))
        && chatMatchesRelation(
          pairId,
          request.resource.data,
          getAfter(/databases/$(database)/documents/relations/$(pairId)).data,
          requestAfter(getAfter(/databases/$(database)/documents/relations/$(pairId)).data.sourceRequestId)
        );

      allow update, delete: if false;

      match /messages/{messageId} {
        allow get: if signedIn() && chatMember(pairId);

        allow list: if signedIn() && chatMember(pairId);

        allow create: if signedIn()
          && chatMember(pairId)
          && request.resource.data.keys().hasOnly(["senderId", "text", "createdAt"])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && !request.resource.data.text.matches('\\s*')
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /trainingSessions/{requestId} {
      allow get: if signedIn() && (
        resource == null
          ? (
            exists(/databases/$(database)/documents/trainingRequests/$(requestId))
            && (
              requestData(requestId).senderId == request.auth.uid
              || requestData(requestId).receiverId == request.auth.uid
            )
          )
          : request.auth.uid in resource.data.members
      );

      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(sessionKeys())
        && request.resource.data.requestId == requestId
        && sessionMatchesRequest(request.resource.data, requestAfter(requestId))
        && existsAfter(/databases/$(database)/documents/relations/$(request.resource.data.relationId))
        && existsAfter(/databases/$(database)/documents/chats/$(request.resource.data.relationId));

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && resource.data.status == "planned"
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"])
        && (
          request.resource.data.status == "cancelled"
          || (
            request.resource.data.status == "done"
            && resource.data.endsAt < request.time
          )
        );

      allow delete: if false;
    }
  }
}
